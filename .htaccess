DirectoryIndex index.html index.php

# Paksa HTTPS: semua kunjungan http:// dialihkan ke https://
RewriteEngine On
# X-Forwarded-Proto diperlukan karena InfinityFree berjalan di belakang proxy:
# tanpa kondisi ini, https yang sah bisa ikut dialihkan -> redirect loop.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Matikan directory listing.
Options -Indexes

# Tolak akses HTTP langsung ke berkas sensitif (mod_rewrite, bukan <FilesMatch>).
RewriteRule ^config/ - [F,L]
RewriteRule \.(sql|md|log|bak|ini)$ - [F,L]

# Header keamanan (dibungkus IfModule agar tidak memicu 500 di server tanpa modul).
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# HSTS (Strict-Transport-Security) sengaja TIDAK ditambahkan:
# sertifikat gratis InfinityFree (ZeroSSL) harus diperpanjang manual,
# dan HSTS akan membuat situs tidak bisa dibuka bila sertifikat kedaluwarsa.
